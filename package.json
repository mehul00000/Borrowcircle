{
  "name": "borrowcircle",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "pnpm --filter apps-web dev",
    "web:build": "pnpm --filter apps-web build",
    "web:typecheck": "pnpm --filter apps-web typecheck",
    "mobile:start": "pnpm --filter apps-mobile start",
    "mobile:typecheck": "pnpm --filter apps-mobile typecheck",
    "typecheck": "pnpm web:typecheck && pnpm mobile:typecheck"
  }
}
