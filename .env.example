# BorrowCircle backend & auth configuration
#
# Backend:  Supabase (database, storage, realtime) — one project for web,
#           Android and iOS
# Auth:     Clerk (all platforms) — Supabase accepts Clerk-issued JWTs via
#           third-party auth, so RLS resolves auth.uid() to the Clerk user id
#
# Without these values every app runs in demo mode (clearly labelled): all
# features work against an isolated on-device/browser demo store.

# ---------------------------------------------------------------------------
# Clerk — authentication (Dashboard → API keys)
# ---------------------------------------------------------------------------
# Website (apps/web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Mobile apps (apps/mobile)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase — backend (Project Settings → API)
# ---------------------------------------------------------------------------
# Website (apps/web)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mobile apps (apps/mobile)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never expose to browser or mobile builds
SUPABASE_SECRET_KEY=

# Optional external services
EMAIL_PROVIDER_API_KEY=
MAPS_API_KEY=
